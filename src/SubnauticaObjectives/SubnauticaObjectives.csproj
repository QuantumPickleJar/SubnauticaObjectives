<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>SubnauticaObjectives</AssemblyName>
    <RootNamespace>SubnauticaObjectives</RootNamespace>
    <!-- Do not copy BepInEx/Unity DLLs into the output — they live in the game folder. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    GamePath.props is git-ignored and must be created locally by each developer.
    Copy GamePath.props.example to GamePath.props and set <GameDir> to your
    Subnautica installation directory.
  -->
  <Import Project="GamePath.props" Condition="Exists('GamePath.props')" />

  <!--
    All game and BepInEx DLL references use HintPath so no external NuGet feed is needed.
    This project targets BepInEx v5 (Mono) for Subnautica.

    References are conditional on $(GameDir) being set so the project still loads in IDEs
    without the game installed; compilation will fail gracefully until GamePath.props is set.
  -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony is included in BepInEx v5 -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assemblies from Subnautica_Data\Managed\ (Mono version) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Subnautica_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Subnautica_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Subnautica_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDir)\Subnautica_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Post-build: copy the plugin DLL to the BepInEx plugins folder for rapid iteration.
    Only runs when $(GameDir) is configured.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(GameDir)' != ''">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)"
      SkipUnchangedFiles="true" />
    <Message
      Text="Deployed $(AssemblyName).dll to $(GameDir)\BepInEx\plugins\$(AssemblyName)"
      Importance="high" />
  </Target>

</Project>
