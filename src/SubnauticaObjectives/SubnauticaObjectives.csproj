<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SubnauticaObjectives</AssemblyName>
    <RootNamespace>SubnauticaObjectives</RootNamespace>
    <!-- Do not copy BepInEx/Unity DLLs into the output — they live in the game folder. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    GamePath.props is git-ignored and must be created locally by each developer.
    Copy GamePath.props.example to GamePath.props and set <GameDir> to your
    Subnautica installation directory.
  -->
  <Import Project="GamePath.props" Condition="Exists('GamePath.props')" />

  <!--
    All game and BepInEx DLL references use HintPath so no external NuGet feed is needed.
    The interop assemblies under BepInEx\interop\ are generated automatically the first
    time you launch Subnautica with Tobey's BepInEx 6 (IL2CPP) pack installed.

    References are conditional on $(GameDir) being set so the project still loads in IDEs
    without the game installed; compilation will fail gracefully until GamePath.props is set.
  -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HarmonyX is bundled with the BepInEx IL2CPP pack -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game interop assemblies (generated by BepInEx IL2CPP on first launch) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Post-build: copy the plugin DLL to the BepInEx plugins folder for rapid iteration.
    Only runs when $(GameDir) is configured.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(GameDir)' != ''">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)"
      SkipUnchangedFiles="true" />
    <Message
      Text="Deployed $(AssemblyName).dll to $(GameDir)\BepInEx\plugins\$(AssemblyName)"
      Importance="high" />
  </Target>

</Project>
