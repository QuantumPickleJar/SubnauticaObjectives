<!--
  GamePath.props.example
  ──────────────────────
  Copy this file to GamePath.props (same directory) and set <GameDir> to the root of your
  Subnautica installation. GamePath.props is git-ignored and never committed to the repo.

  Typical locations:
    Windows Steam : C:\Program Files (x86)\Steam\steamapps\common\Subnautica
    Windows Epic  : C:\Program Files\Epic Games\Subnautica
    Linux Steam   : ~/.steam/steam/steamapps/common/Subnautica

  Prerequisites:
    1. Install BepInEx v5 (Mono) for Subnautica.
       https://www.nexusmods.com/subnautica/mods/1108
       or
       https://github.com/toebeann/BepInEx.Subnautica (find the Mono release)
    2. No additional setup needed beyond standard BepInEx installation.
    3. Set <GameDir> below and build this project.

  The post-build target will automatically copy SubnauticaObjectives.dll to
  <GameDir>\BepInEx\plugins\SubnauticaObjectives\ after each successful build.

  Also copy data\campaign.graph.json to
  <GameDir>\BepInEx\plugins\SubnauticaObjectives\data\campaign.graph.json
  (once only, or after any graph changes).

  NOTE: Do NOT use Nautilus. This mod targets Nitrox co-op and Nautilus is not
        compatible with Nitrox. All game APIs are accessed directly via BepInEx + Harmony.
-->
<Project>
  <PropertyGroup>
    <GameDir>D:\Games\Steam\steamapps\common\Subnautica</GameDir>
  </PropertyGroup>
</Project>
